# DeepSeek API
DEEPSEEK_API_KEY=sk-...

# Modelo de DeepSeek. Por defecto deepseek-v4-flash (barato); el otro es
# deepseek-v4-pro. Ojo: los nombres viejos (deepseek-chat) devuelven 400.
DEEPSEEK_MODEL=deepseek-v4-flash

# Timeout (segundos) para llamadas a DeepSeek. Por defecto 120s.
# Evita que query_context/audit_project se cuelguen hasta 10 min (default del SDK).
# No lo bajes si subes DEEPSEEK_MAX_TOKENS: generar más texto tarda más.
DEEPSEEK_TIMEOUT=120.0

# Presupuesto de salida por llamada. En los modelos v4 el bloque `thinking` SALE
# DE AQUÍ: con 4096, un lote grande del audit se quedaba sin presupuesto razonando
# y devolvía una respuesta sin texto, que caía al fallback de chunks crudos —
# categoría con 0 tokens y sin hallazgos, idéntica a "todo limpio".
DEEPSEEK_MAX_TOKENS=16384

# Precios USD por 1M tokens. Desde el 2026-08-16 DeepSeek factura por franja
# horaria y off-peak cuesta la MITAD que peak. Las horas peak se declaran en UTC;
# en hora de Ecuador (UTC-5) caen en 20:00-23:00 y 01:00-05:00, así que trabajando
# de día siempre pagas off-peak. Van en env porque ya cambiaron una vez.
DEEPSEEK_PRICE_IN_OFFPEAK=0.22
DEEPSEEK_PRICE_OUT_OFFPEAK=0.66
DEEPSEEK_PRICE_IN_PEAK=0.44
DEEPSEEK_PRICE_OUT_PEAK=1.32
DEEPSEEK_PEAK_HOURS_UTC=1-4,6-10

# GitHub (scope: repo) — para repos privados, también funciona con públicos
GITHUB_TOKEN=ghp_...

# PostgreSQL en Railway (URL pública para acceso externo)
DATABASE_URL=postgresql://postgres:password@...railway.app:5432/railway

# Identificador de ESTE dispositivo. Como varios equipos comparten la misma
# Postgres, cada proyecto guarda una ruta local por dispositivo (device_paths).
# Poné un nombre estable y distinto en cada máquina (ej. desktop, laptop).
# Si se omite, se usa el hostname del sistema.
DEVICE_ID=desktop

# Directorio base donde se clonan repos con clone_project
PROJECTS_BASE_PATH=/home/mickaell/projects

# Directorio donde ChromaDB persiste los vectores en disco
CHROMA_PERSIST_PATH=/home/mickaell/chroma_data

# Nivel de log (INFO por defecto)
LOG_LEVEL=INFO

# Umbral de distancia coseno para filtrar chunks (0=idéntico, 2=opuesto).
# MiniLM NL->código suele dar 0.6-1.1; por eso el default es 1.2.
MAX_DISTANCE=1.2

# Modelo de embeddings (SentenceTransformers). Por defecto all-MiniLM-L6-v2.
# Para mejor recall sobre código: jinaai/jina-embeddings-v2-base-code o
# nomic-ai/nomic-embed-text-v1.5. OJO: cambiarlo invalida el índice Chroma
# existente (cambia la dimensión del vector) y exige reindex FULL de todo.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Nº de chunks que recupera cada categoría del audit (recall > costo). Default 18.
AUDIT_TOP_K=18

# Batching del audit: las categorías estructurales (accessibility, theming) cargan
# TODOS los chunks de components/app, que en un repo grande superan la ventana del
# modelo. audit_batches parte los chunks en lotes de este tamaño (~4 chars/token)
# y los audita EN PARALELO. 45K ≈ 11K tokens por lote: con lotes de 30K el modelo
# razonaba tanto que agotaba max_tokens antes de escribir y se perdía el lote entero.
AUDIT_BATCH_MAX_CHARS=45000

# Tope total de chunks por categoría del audit. 0 = sin tope (audita todo en lotes,
# recall máximo). Subilo a un entero para acotar el costo en repos grandes.
AUDIT_MAX_CHUNKS=0

# Presupuesto TOTAL de caracteres del audit en modo raw (todas las categorías).
# Evita respuestas de 300K+ chars que saturan el contexto del que llama.
# Las categorías que no entren avisan pedirse solas con categories=[...]. 0 = sin tope.
AUDIT_RAW_MAX_CHARS=150000

# Verificación de hallazgos CRÍTICO/ALTO del audit contra el archivo completo
# citado (segunda pasada DeepSeek, anti-falsos-positivos). false la desactiva.
AUDIT_VERIFY_ENABLED=true

# Llamadas a DeepSeek en paralelo durante un audit. El audit son N categorías x M
# lotes de I/O de red: en serie tardaba minutos en repos grandes. Subirlo mucho
# puede disparar rate limits (429) de DeepSeek; bajarlo a 1 vuelve al modo serie.
AUDIT_CONCURRENCY=4

# Presupuesto de salida de describe_project. Necesita más que DEEPSEEK_MAX_TOKENS
# porque son 5 secciones de prosa Y el modelo razona antes de escribir (el bloque
# `thinking` sale del mismo presupuesto): con el default devolvía una respuesta
# vacía que caía al fallback de chunks crudos.
PROFILE_MAX_TOKENS=12000

# Reranking híbrido post-retrieval (semántico + léxico). Rescata matches exactos
# de tokens que el embedding pierde. RERANK_ENABLED=false lo desactiva.
RERANK_ENABLED=true
RERANK_CANDIDATE_MULT=3
RERANK_W_SEM=0.7
RERANK_W_LEX=0.3
