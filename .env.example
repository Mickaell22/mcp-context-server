# DeepSeek API
DEEPSEEK_API_KEY=sk-...

# Timeout (segundos) para llamadas a DeepSeek. Por defecto 60s.
# Evita que query_context/audit_project se cuelguen hasta 10 min (default del SDK).
DEEPSEEK_TIMEOUT=60.0

# GitHub (scope: repo) — para repos privados, también funciona con públicos
GITHUB_TOKEN=ghp_...

# PostgreSQL en Railway (URL pública para acceso externo)
DATABASE_URL=postgresql://postgres:password@...railway.app:5432/railway

# Directorio base donde se clonan repos con clone_project
PROJECTS_BASE_PATH=/home/mickaell/projects

# Directorio donde ChromaDB persiste los vectores en disco
CHROMA_PERSIST_PATH=/home/mickaell/chroma_data

# Nivel de log (INFO por defecto)
LOG_LEVEL=INFO

# Umbral de distancia coseno para filtrar chunks (0=idéntico, 2=opuesto).
# MiniLM NL->código suele dar 0.6-1.1; por eso el default es 1.2.
MAX_DISTANCE=1.2

# Modelo de embeddings (SentenceTransformers). Por defecto all-MiniLM-L6-v2.
# Para mejor recall sobre código: jinaai/jina-embeddings-v2-base-code o
# nomic-ai/nomic-embed-text-v1.5. OJO: cambiarlo invalida el índice Chroma
# existente (cambia la dimensión del vector) y exige reindex FULL de todo.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Nº de chunks que recupera cada categoría del audit (recall > costo). Default 18.
AUDIT_TOP_K=18

# Batching del audit: deepseek-chat tiene ~64K tokens de ventana. Las categorías
# estructurales (accessibility, theming) cargan TODOS los chunks de components/app,
# que en un repo grande superan la ventana. audit_context parte los chunks en lotes
# que no excedan este presupuesto de caracteres (~4 chars/token; 120K ≈ 30K tokens).
AUDIT_BATCH_MAX_CHARS=120000

# Tope total de chunks por categoría del audit. 0 = sin tope (audita todo en lotes,
# recall máximo). Subilo a un entero para acotar el costo en repos grandes.
AUDIT_MAX_CHUNKS=0

# Reranking híbrido post-retrieval (semántico + léxico). Rescata matches exactos
# de tokens que el embedding pierde. RERANK_ENABLED=false lo desactiva.
RERANK_ENABLED=true
RERANK_CANDIDATE_MULT=3
RERANK_W_SEM=0.7
RERANK_W_LEX=0.3
